# ==================================================================
# Variables de entorno del Sistema Hotel Princes Ica
# 1. Copiar este archivo como .env      (cp .env.example .env)
# 2. Completar los valores.             El archivo .env NUNCA se sube a GitHub.
# ==================================================================

# ---------------- Base de datos ----------------
# Opción A: PostgreSQL local en Docker (docker compose --profile local up)
DB_NAME=hotel_princes_ica
DB_USER=hotel_user
DB_PASSWORD=cambia_esta_clave
# URL para ejecutar el backend fuera de Docker (./mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5432/hotel_princes_ica
# URL que usa el contenedor del backend (la base local se llama "db")
DB_URL_DOCKER=jdbc:postgresql://db:5432/hotel_princes_ica

# Opción B: Supabase (Project Settings > Database > Connection string > Session pooler)
# Deje DB_URL_DOCKER vacío y complete:
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<clave de la base de datos de Supabase>
# DB_URL_DOCKER=

# Conexiones simultáneas (Supabase Free admite pocas)
DB_POOL_SIZE=5
# update = crea/ajusta tablas; validate = solo verifica (producción)
DDL_AUTO=update

# ---------------- Fotos de habitaciones (Supabase Storage) ----------------
# local = carpeta del servidor; supabase = bucket público (Storage > New bucket > "habitaciones", Public)
STORAGE_TIPO=local
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings > API > service_role (solo backend, nunca en el frontend)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=habitaciones
APP_BACKEND_URL=http://localhost:8080

# ---------------- Seguridad ----------------
# Mínimo 32 caracteres aleatorios
JWT_SECRET=genera-una-clave-larga-y-aleatoria-aqui-de-32-o-mas
JWT_EXPIRATION_MINUTES=480
# Orígenes que pueden llamar al API (separados por coma)
CORS_ORIGINS=http://localhost:3000

# ---------------- Frontend ----------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_MODO_DEMO=false

# ---------------- Puertos en tu PC (opcional) ----------------
BACKEND_PUERTO_HOST=8080
FRONTEND_PUERTO_HOST=3000
DB_PUERTO_HOST=5432

# ---------------- pgAdmin (--profile herramientas) ----------------
PGADMIN_EMAIL=admin@hotelprincesica.com
PGADMIN_PASSWORD=cambia_esta_clave

# ---------------- IA generativa libre (Llama) ----------------
# groq   = Llama 3.3 70B en la nube, gratis con cuenta en console.groq.com (crear API key)
# ollama = Llama 3.2 en tu PC con Docker (--profile ia-local), sin clave
# ninguno = sin IA (respuestas por reglas)
IA_PROVEEDOR=groq
IA_API_KEY=
# Opcionales: si se dejan vacíos se usan los valores del proveedor
IA_MODELO=
IA_BASE_URL=
# Para Ollama dentro de Docker use IA_PROVEEDOR=ollama y deje IA_BASE_URL vacío (http://ollama:11434/v1)
OLLAMA_MODELO=llama3.2:3b
