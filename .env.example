# Copiar como .env y completar. Nunca subir el archivo .env al repositorio.

# Base de datos PostgreSQL
DB_NAME=hotel_princes_ica
DB_USER=hotel_user
DB_PASSWORD=cambia_esta_clave
DB_URL=jdbc:postgresql://localhost:5432/hotel_princes_ica

# pgAdmin
PGADMIN_EMAIL=admin@hotelprincesica.com
PGADMIN_PASSWORD=cambia_esta_clave

# Frontend permitido para CORS
CORS_ORIGINS=http://localhost:3000

# Seguridad JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=genera-una-clave-larga-y-aleatoria-aqui
JWT_EXPIRATION_MINUTES=480

# Asistente IA (opcional). Sin clave, el asistente funciona con reglas fijas.
ANTHROPIC_API_KEY=
ASISTENTE_IA_MODELO=claude-haiku-5-5
